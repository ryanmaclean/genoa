#!/bin/sh
# ii-agent — cloud agent for genoa images
# SPDX-License-Identifier: Apache-2.0
# Runs as: /usr/local/bin/ii-agent [version|status|run-task|heartbeat|start]
#
# Shell-native implementation — works with /bin/sh alone (FreeBSD base.txz).
# No dependency on nushell or any port. Uses only: sh, hostname, uname, date,
# sed, printf, sleep, fetch (FreeBSD base) or curl (optional).

VERSION="v0.2.0"
ENDPOINT="${II_AGENT_ENDPOINT:-http://localhost:7071/task}"

case "$1" in
  version)
    printf '{"version":"%s","platform":"%s","arch":"%s"}\n' \
      "$VERSION" "$(uname -s)" "$(uname -m)"
    ;;
  status)
    HOSTNAME="$(hostname -s 2>/dev/null || hostname)"
    TS="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u)"
    printf '{"version":"%s","hostname":"%s","platform":"%s","timestamp":"%s","ok":true}\n' \
      "$VERSION" "$HOSTNAME" "$(uname -s)" "$TS"
    ;;
  run-task)
    CMD="${2:-uname -a}"
    OUTPUT="$(sh -c "$CMD" 2>&1)"
    RC=$?
    # Escape the output for JSON (backslash, double-quote, then collapse newlines to \n)
    OUTPUT_ESC="$(printf '%s' "$OUTPUT" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/g' | tr -d '\n')"
    printf '{"action":"ran","cmd":"%s","exit_code":%d,"output":"%s"}\n' \
      "$CMD" "$RC" "${OUTPUT_ESC%\\n}"
    ;;
  heartbeat)
    HOSTNAME="$(hostname -s 2>/dev/null || hostname)"
    TS="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u)"
    PAYLOAD="{\"version\":\"$VERSION\",\"hostname\":\"$HOSTNAME\",\"event\":\"heartbeat\",\"timestamp\":\"$TS\"}"
    if [ "${2}" = "--dry-run" ]; then
      printf '{"action":"would-post","endpoint":"%s","payload":%s}\n' "$ENDPOINT" "$PAYLOAD"
    else
      if command -v fetch >/dev/null 2>&1; then
        fetch -q -o /dev/null --post-data="$PAYLOAD" --header="Content-Type: application/json" "$ENDPOINT" 2>/dev/null \
          && printf '{"action":"posted","endpoint":"%s","status":"ok"}\n' "$ENDPOINT" \
          || printf '{"action":"failed","endpoint":"%s","error":"fetch failed"}\n' "$ENDPOINT"
      elif command -v curl >/dev/null 2>&1; then
        curl -sf -X POST -H "Content-Type: application/json" -d "$PAYLOAD" "$ENDPOINT" >/dev/null 2>&1 \
          && printf '{"action":"posted","endpoint":"%s","status":"ok"}\n' "$ENDPOINT" \
          || printf '{"action":"failed","endpoint":"%s","error":"curl failed"}\n' "$ENDPOINT"
      else
        printf '{"action":"failed","error":"no HTTP client available (need fetch or curl)"}\n'
      fi
    fi
    ;;
  start)
    # Background loop: send heartbeat every 60s until killed
    while true; do
      "$0" heartbeat >/dev/null 2>&1
      sleep 60
    done
    ;;
  *)
    printf '{"version":"%s","subcommands":["version","status","run-task","heartbeat","start"]}\n' "$VERSION"
    ;;
esac
