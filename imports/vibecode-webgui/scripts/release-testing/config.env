# Release Testing Configuration
# =============================
# Configuration for automated GitHub release testing with Tart VMs

# Tart VM Storage Configuration
# CRITICAL: VMs must be stored at /Volumes/downloads to prevent local disk exhaustion
TART_HOME=/Volumes/downloads/tart-vms

# GitHub Repository Configuration
GITHUB_OWNER=ryanmaclean
GITHUB_REPO=vibecode-webgui
GITHUB_FULL_REPO=${GITHUB_OWNER}/${GITHUB_REPO}

# GitHub CLI Configuration
# Uses `gh auth login` credentials - ensure gh is authenticated before running
GH_CMD=/opt/homebrew/bin/gh

# Base VM Image Configuration
# Default: macOS Sequoia base image from Cirrus Labs
BASE_IMAGE=ghcr.io/cirruslabs/macos-sequoia-base:latest

# VM Resource Configuration
VM_CPU=4
VM_MEMORY=8192
VM_NAME_PREFIX=release-test

# SSH Configuration (Tart VM defaults)
SSH_USER=admin
SSH_PASSWORD=admin
SSH_TIMEOUT=5
SSH_MAX_WAIT_ATTEMPTS=60
SSH_WAIT_INTERVAL=5

# Test Configuration
# Maximum time (in seconds) for a single release test
TEST_TIMEOUT=3600
# Minimum free disk space (in GB) required before creating a VM
MIN_DISK_SPACE_GB=20

# Output Configuration
RESULTS_DIR=./release-test-results
LOG_FILE=./release-test.log
REPORT_FILE=./release-test-report.md

# Feature Flags
# Set to true to skip actual VM operations (for testing scripts)
DRY_RUN=false
# Set to true for verbose output
VERBOSE=false
