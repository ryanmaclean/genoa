# EFI-stub kernel config for Apple Virtualization Framework
# Enables direct EFI boot without GRUB bootloader
# Target: Sub-3s cold boot to /healthz

# EFI support (critical for EFI-stub boot)
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_GENERIC_STUB=y
CONFIG_EFI_BOOTLOADER_CONTROL=n
CONFIG_EFI_CAPSULE_LOADER=n
CONFIG_EFI_VARS=n
CONFIG_EFIVAR_FS=n

# ARM64 Apple Silicon optimizations
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARCH_APPLE=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_UAO=y
CONFIG_ARM64_SVE=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_E0PD=y

# Apple Silicon errata
CONFIG_ARM64_ERRATUM_2981881=y
CONFIG_ARM64_ERRATUM_2966298=y

# Apple VF virtio support
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# Fast boot optimizations
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EXPERT=y
CONFIG_MODULES=n

# Initramfs support
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y

# Device support
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV=y

# Networking (minimal for /healthz)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IPV6=n
CONFIG_NETFILTER=n
CONFIG_PACKET=y
CONFIG_UNIX=y

# Serial console
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Random number generator
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Disable unnecessary features for fast boot
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_USB_SUPPORT=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_VT=n
CONFIG_INPUT=n
CONFIG_SERIO=n
CONFIG_I2C=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_SECURITY=n
CONFIG_AUDIT=n
CONFIG_DEBUG_KERNEL=n
CONFIG_TRACING=n
CONFIG_FTRACE=n

# Power management (minimal)
CONFIG_PM=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM_PSCI_FW=y

# Filesystem (minimal)
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n

# SMMU for Apple VF
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_V3=y

# Size optimization
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SLOB=n
CONFIG_SLUB=y

# Fast init
CONFIG_DEFAULT_INIT="/init"
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
