# STUB TLS CA BUNDLE
# This file is embedded at build time by genoa-config/build.rs.
# Replace with a real CA bundle (e.g. mozilla/certifi, or a pinned single DER root)
# before deploying.
#
# For production unikernel builds the recommended approach is:
#   1. Pin a single CA cert (DER) for the control-plane domain.
#   2. Embed it via include_bytes!() in build.rs.
#   3. Load it via rustls::RootCertStore::add_parsable_certificates().
#
# The rustls crate supports no_std root stores as of 0.23 via the
# `aws-lc-rs` or `ring` feature (both Apache-2.0 / ISC).
#
# PLACEHOLDER — NOT A REAL CERTIFICATE
-----BEGIN CERTIFICATE-----
PLACEHOLDER+THIS+IS+NOT+A+REAL+CERTIFICATE+DO+NOT+USE+IN+PRODUCTION+AA
AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
-----END CERTIFICATE-----
