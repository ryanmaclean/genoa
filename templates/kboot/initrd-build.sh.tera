#!/bin/bash
# initrd-build.sh.tera — Build kboot.cpio.gz initrd for FreeBSD
# Generated by genoa v1 — DO NOT EDIT
# Template: templates/kboot/initrd-build.sh.tera
#
# This script constructs the kboot initrd containing:
#   - loader.kboot binary as /init (FreeBSD bootloader)
#   - loader.kboot.conf (kernel boot configuration)
#   - FreeBSD kernel and modules
#   - Essential binaries and libraries for kboot operation
#
# The initrd is booted by Linux (via GRUB) and runs loader.kboot as PID 1.
# loader.kboot then uses Linux syscalls to load the FreeBSD kernel and kexec into it.
#
# License: BSD-2-Clause
# SPDX-License-Identifier: BSD-2-Clause

set -e

WORKDIR="${WORKDIR:-/tmp/kboot-initrd-build}"
OUTPUT="${OUTPUT:-/tmp/kboot.cpio.gz}"
HOSTNAME="{{ hostname }}"
TASK_ENDPOINT="{{ task_endpoint }}"

echo "[kboot-initrd] Building kboot initrd in $WORKDIR"

# Create working directory structure
mkdir -p "$WORKDIR/initrd"
cd "$WORKDIR/initrd"

# Initialize root filesystem for initrd
mkdir -p bin sbin lib lib64 usr/bin usr/sbin usr/lib dev proc sys etc mnt
mkdir -p boot/kernel boot/modules

# Copy loader.kboot binary (must be pre-built)
# FreeBSD build command:
#   cd /usr/src/stand/kboot
#   make MK_LOADER_KBOOT=yes MACHINE_CPUARCH=amd64
#   Result: stand/kboot/kboot (ELF binary, ~500 KB)

if [ ! -f "/usr/src/stand/kboot/kboot" ]; then
    echo "[kboot-initrd] ERROR: loader.kboot binary not found at /usr/src/stand/kboot/kboot"
    echo "[kboot-initrd] Build with: cd /usr/src/stand/kboot && make MK_LOADER_KBOOT=yes MACHINE_CPUARCH=amd64"
    exit 1
fi

cp /usr/src/stand/kboot/kboot "$WORKDIR/initrd/init"
chmod 755 "$WORKDIR/initrd/init"

echo "[kboot-initrd] Copied loader.kboot as /init"

# Copy FreeBSD kernel
# Expected location: /boot/kernel/kernel (from FreeBSD base installation)
if [ ! -f "/boot/kernel/kernel" ]; then
    echo "[kboot-initrd] ERROR: FreeBSD kernel not found at /boot/kernel/kernel"
    echo "[kboot-initrd] Install FreeBSD base system first"
    exit 1
fi

cp /boot/kernel/kernel "$WORKDIR/initrd/boot/kernel/"
echo "[kboot-initrd] Copied FreeBSD kernel"

# Copy essential kernel modules
# At minimum: ext2fs (for reading ext4 boot partition), zfs (if needed for root)
if [ -d "/boot/kernel" ]; then
    for mod in ext2fs.ko zfs.ko opensolaris.ko; do
        if [ -f "/boot/kernel/$mod" ]; then
            cp "/boot/kernel/$mod" "$WORKDIR/initrd/boot/kernel/" || true
        fi
    done
fi

echo "[kboot-initrd] Copied kernel modules"

# Create loader.kboot.conf configuration file
# This file is read by loader.kboot to configure FreeBSD kernel boot parameters
cat > "$WORKDIR/initrd/loader.kboot.conf" <<'LOADER_EOF'
# loader.kboot.conf — FreeBSD kernel boot configuration
# Generated by genoa kboot initrd builder
#
# Hostname and task endpoint (rendered by genoa)
hostname="{{ hostname }}"
task_endpoint="{{ task_endpoint }}"

# Root filesystem hint — tell FreeBSD kernel where to mount root
# /dev/vtbd0p3 is partition 3 of the boot disk (UFS2 root in this setup)
vfs.root.mountfrom="ufs:/dev/vtbd0p3"

# Verbose boot output (helpful for debugging)
boot_verbose="YES"

# Serial console (common for cloud instances)
console="comconsole,vidconsole"
comconsole_speed="115200"

# Kernel modules to load
autoboot_delay="3"

# Load ext2fs module for ext4 filesystem support (in case needed)
# module_load="ext2fs_load=YES"
LOADER_EOF

echo "[kboot-initrd] Created loader.kboot.conf"

# Create essential device nodes (devices needed for boot)
# kboot and the Linux kernel together provide these, but we include minimal versions
if [ -c "/dev/null" ]; then
    cp -r /dev/null "$WORKDIR/initrd/dev/" 2>/dev/null || true
fi

# Copy minimal libc and essential libraries
# The exact libraries depend on loader.kboot's dependencies
# Typically: libc, libm, libutil
if [ -d "/lib" ]; then
    for lib in libc.so.7 libm.so.5 libutil.so.9; do
        if [ -f "/lib/$lib" ]; then
            cp "/lib/$lib" "$WORKDIR/initrd/lib/" 2>/dev/null || true
        fi
    done
fi

if [ -d "/usr/lib" ]; then
    for lib in libcompiler_rt.so.1; do
        if [ -f "/usr/lib/$lib" ]; then
            cp "/usr/lib/$lib" "$WORKDIR/initrd/usr/lib/" 2>/dev/null || true
        fi
    done
fi

echo "[kboot-initrd] Copied essential libraries"

# Create a minimal /etc/ld-elf.so.conf for library loading
mkdir -p "$WORKDIR/initrd/etc"
cat > "$WORKDIR/initrd/etc/ld-elf.so.conf" <<'ETC_EOF'
/lib
/usr/lib
ETC_EOF

# Build the cpio archive
# Format: newc (new ASCII format, portable)
# Compression: gzip (required by GRUB)
echo "[kboot-initrd] Creating cpio archive..."

cd "$WORKDIR/initrd"
find . | cpio -o -H newc | gzip > "$OUTPUT"

echo "[kboot-initrd] Created $OUTPUT"
ls -lh "$OUTPUT"

# Checksum for verification
if [ -x "$(command -v sha256sum)" ]; then
    echo "[kboot-initrd] SHA256: $(sha256sum "$OUTPUT" | awk '{print $1}')"
fi

echo "[kboot-initrd] Build complete"
