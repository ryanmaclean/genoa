# loader.kboot.conf — FreeBSD kernel boot configuration
# Generated by genoa v1 — DO NOT EDIT
# Template: templates/kboot/loader-kboot.conf.tera
#
# This configuration file is read by loader.kboot (running as Linux PID 1)
# to set kernel parameters before calling kexec() into FreeBSD.
#
# loader.kboot is a FreeBSD bootloader that runs inside a Linux initrd
# and uses Linux syscalls to access filesystems. It then hands off to
# the FreeBSD kernel via kexec.
#
# Reference: https://cgit.freebsd.org/src/tree/stand/kboot
# License: BSD-2-Clause

# ─── Hostname and Metadata ────────────────────────────────────────────────────
hostname="{{ hostname }}"
task_endpoint="{{ task_endpoint }}"

# ─── Root Filesystem Configuration ────────────────────────────────────────────
# Tell FreeBSD kernel where to mount root.
# /dev/vtbd0p3 assumes:
#   - Boot disk is /dev/vtbd0 (virtio block device, standard for cloud)
#   - Partition 3 is UFS2 root (created by genoa profile)
#
# Alternative if using ZFS root:
#   vfs.root.mountfrom="zfs:zroot/data"
vfs.root.mountfrom="ufs:/dev/vtbd0p3"

# ─── Boot Verbosity ───────────────────────────────────────────────────────────
# Enable verbose output during boot (helpful for debugging cloud instances)
boot_verbose="YES"

# ─── Console Configuration ────────────────────────────────────────────────────
# Serial console is standard for cloud VMs (Linode, AWS, GCP, etc.)
# The Linux kernel already configured ttyS0; FreeBSD will take over.
console="comconsole,vidconsole"
comconsole_speed="115200"

# ─── Kernel Modules ───────────────────────────────────────────────────────────
# loader.kboot loads modules listed here before handing off to kernel
# These are optional; the kernel can load them later if needed.

# ext2fs module — for ext4 filesystem support (if root is ext4)
# ext2fs_load="YES"

# zfs module — if root is ZFS (uncomment if using ZFS root)
# zfs_load="YES"

# ─── Boot Delay ───────────────────────────────────────────────────────────────
# Allow time for boot menu (if interactive boot desired)
autoboot_delay="3"

# ─── Memory and Debug ─────────────────────────────────────────────────────────
# Enable kernel debugging output if system hangs
# Set to "3" for maximum verbosity
boot_debug="0"

# ─── Initialization Script ────────────────────────────────────────────────────
# If an init script is needed in the FreeBSD root, set it here
# (default: /sbin/init)
# init_path="/sbin/init"

# ─── Root Hints (Advanced) ────────────────────────────────────────────────────
# These hints are passed to the kernel to help locate root filesystem
# Normally auto-detected, but can be overridden here
# rootfs_type="ufs"

# ─── Cloud Metadata ───────────────────────────────────────────────────────────
# Store provider metadata for agent initialization
# Used by genoa tasks and autonomous agents
provider_metadata_endpoint="{{ task_endpoint }}"
