# GRUB2 configuration for FreeBSD via loader.kboot
# Generated by genoa v1 — DO NOT EDIT
# Template: templates/kboot/grub.cfg.tera
#
# Boot sequence:
#   GRUB2 (on ext4) → Linux kernel + kboot initrd
#   → loader.kboot reads FreeBSD kernel via Linux syscalls
#   → kexec() to FreeBSD kernel
#   → FreeBSD mounts UFS2 root on partition 3
#
# License: BSD-2-Clause

set default=0
set timeout=3

# Color scheme for GRUB menu
set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

menuentry "FreeBSD via loader.kboot" {
    echo "Loading FreeBSD kernel via loader.kboot..."

    # Linux kernel (minimal) with kboot as init process
    # init=/loader.kboot tells the Linux kernel to run loader.kboot as PID 1
    linux /boot/vmlinuz-kboot root=/dev/sda2 init=/loader.kboot quiet console=ttyS0,115200

    # kboot.cpio.gz is the initrd containing:
    #   - loader.kboot binary (as /init)
    #   - loader.kboot.conf (kernel boot parameters)
    #   - FreeBSD kernel
    #   - FreeBSD kernel modules
    initrd /boot/kboot.cpio.gz
}

# Fallback entries for debugging

menuentry "Linux Rescue Shell" {
    echo "Booting to Linux emergency shell for debugging..."
    linux /boot/vmlinuz-kboot root=/dev/sda2 init=/bin/sh quiet
    initrd /boot/kboot.cpio.gz
}

# Hostname for reference: {{ hostname }}
# Task endpoint: {{ task_endpoint }}
