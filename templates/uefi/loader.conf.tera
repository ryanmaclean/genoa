# /boot/loader.conf — FreeBSD EFI bootloader configuration
# Generated by genoa v1 — DO NOT EDIT
# Template: templates/uefi/loader.conf.tera
# Profile: uefi
#
# Read by loader.efi (BSD-2-Clause) at UEFI boot time.
# loader.efi source: stand/efi/loader/ in FreeBSD src tree.
# Boot chain: UEFI firmware → EFI/BOOT/BOOTx64.EFI → loader.efi → /boot/loader.conf → kernel
#
# SPDX-License-Identifier: BSD-2-Clause

# ─── Hostname ─────────────────────────────────────────────────────────────────
# Set at loader level so kernel knows it before init runs
hint.hostname.0="{{ hostname }}"

# ─── Serial Console ───────────────────────────────────────────────────────────
# comconsole + vidconsole: output on both serial (ttyS0) and VGA/EFI GOP.
# boot_multicons + boot_serial enable dual-console mode so SSH and KVM work.
comconsole_speed="{{ console_speed }}"
console="comconsole,vidconsole"
boot_multicons="YES"
boot_serial="YES"

# ─── Kernel Tuning ────────────────────────────────────────────────────────────
# kern.hz: interrupt frequency. 100 Hz is correct for VM/cloud; reduces idle CPU burn.
# 1000 Hz is for bare metal latency-sensitive workloads.
kern.hz={{ kern_hz }}
# vfs.root.mountfrom: tell loader.efi which GPT partition is the root filesystem.
# Without this the loader guesses wrong and the VM hangs at mountroot>.
# The label "rootfs" matches: gpart add -t freebsd-ufs -l rootfs (uefi.nu step 4).
vfs.root.mountfrom="ufs:/dev/gpt/rootfs"
# kern.vty=vt: use the vt(4) virtual terminal driver (works correctly under KVM/QEMU).
kern.vty=vt

# ─── Boot Menu ────────────────────────────────────────────────────────────────
# Short delay before auto-boot — enough for serial console to attach.
autoboot_delay="3"

# ─── Virtio / Cloud Driver Modules ───────────────────────────────────────────
# Load ENA (AWS Elastic Network Adapter) and GVE (Google Virtio Ethernet) modules.
# These must be available before the kernel probes PCI devices.
if_ena_load="YES"
gve_load="YES"
