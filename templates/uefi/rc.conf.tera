# /etc/rc.conf — FreeBSD base system service configuration
# Generated by genoa v1 — DO NOT EDIT
# Template: templates/uefi/rc.conf.tera
# Profile: uefi
#
# SPDX-License-Identifier: BSD-2-Clause

# ─── Identity ─────────────────────────────────────────────────────────────────
hostname="{{ hostname }}"

# ─── Networking ───────────────────────────────────────────────────────────────
# DHCP on all interfaces via ifconfig_DEFAULT. This covers virtio (vtnet0),
# ENA (ena0), GVE (gve0), and NVMe/virtio-block naming variants.
ifconfig_DEFAULT="DHCP"

# ─── SSH ──────────────────────────────────────────────────────────────────────
sshd_enable="YES"

# ─── Time ─────────────────────────────────────────────────────────────────────
ntpd_enable="YES"
ntpd_sync_on_start="YES"

# ─── Filesystem growth on first boot ─────────────────────────────────────────
# growfs expands the UFS root partition to fill the entire disk.
# Required for cloud images that are cloned to larger volumes.
growfs_enable="YES"

# ─── Entropy / RNG ────────────────────────────────────────────────────────────
# virtio_random feeds the kernel entropy pool from the hypervisor RNG.
# Without this, /dev/random may block on first boot until enough entropy accumulates.
virtio_random_load="YES"

# ─── Agent service ────────────────────────────────────────────────────────────
{% if agent_enabled %}{{ agent_name }}_enable="YES"{% else %}# {{ agent_name }}_enable="NO"  # agent disabled in manifest{% endif %}
