#cloud-config
# Generated by genoa v1 — DO NOT EDIT
# Template: templates/cloud-init/user-data.tera
# Manifest: ai-assistant-edge-v1
#
# IMPORTANT — NoCloud datasource cache:
# cloud-init caches per-datasource. The instance-id in meta-data drives
# re-execution. genoa sets instance-id = sha256(manifest_toml) so every
# distinct manifest produces a distinct instance-id, forcing re-run.
# Merely bumping kernel cmdline / re-mounting the seed ISO does NOT
# invalidate the cache if instance-id is unchanged.
# Ref: https://cloudinit.readthedocs.io/en/latest/reference/datasources/nocloud.html

hostname: ai-edge-01
fqdn: ai-edge-01.local
manage_etc_hosts: true
locale: en_US.UTF-8
timezone: America/Vancouver

# ─── Users ────────────────────────────────────────────────────────────────────
users:
  - name: root
    lock_passwd: true
  - name: ryan
    gecos: Ryan MacLean
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyReplaceMeWithRealKey ryan@example.com
  - name: deploy
    gecos: Genoa Deploy Service Account
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart *, /usr/bin/systemctl start *, /usr/bin/systemctl stop *"
    lock_passwd: true


{% if user.ssh_keys_secret_ref is defined %}
    # SSH keys from secret: 
    # Resolved at runtime by genoa seed-iso builder — never inlined here
    ssh_authorized_keys: {{ "{{" }}secret:{{ user.ssh_keys_secret_ref }}{{ "}}" }}
{% endif %}
{% endfor %}

# ─── Package management ────────────────────────────────────────────────────────
package_update: true
package_upgrade: true
packages:
  - curl
  - ca-certificates
  - gnupg
  - jq
  - git
  - htop
  - iotop
  - tcpdump
  - nmap
  - tmux
  - vim
  - python3-venv
  - nodejs
  - npm


# ─── Write files ───────────────────────────────────────────────────────────────
write_files:
  - path: /etc/genoa-manifest-id
    content: "ai-assistant-edge-v1\n"
    permissions: "0644"
    owner: root:root

  - path: /etc/datadog-agent/datadog.yaml
    permissions: "0640"
    owner: "root:dd-agent"
    # DD_API_KEY is resolved from secret: DD_API_KEY
    # Never inlined — injected by systemd EnvironmentFile or secrets manager
    content: |
      api_key: "DD_API_KEY}}"
      site: datadoghq.com
      hostname: ai-edge-01
      tags:
        - "env:edge"
        - "team:platform"
        - "managed-by:genoa"
        - "host:ai-edge-01"

      logs_enabled: true
      apm_config:
        enabled: true
      process_config:
        enabled: true

  - path: /etc/systemd/system/ollama.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Ollama LLM runtime
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=ollama
      Group=ollama
      ExecStart=/usr/local/bin/ollama serve
      Restart=always
      RestartSec=3
      Environment="OLLAMA_HOST=0.0.0.0:11434"
      Environment="OLLAMA_KEEP_ALIVE=24h"
      Environment="HOME=/var/lib/ollama"

      [Install]
      WantedBy=multi-user.target

{% if ii_agent_enabled | default(value=false) %}
  - path: /etc/systemd/system/ii-agent.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=ii-agent autonomous agent runtime
      After=network-online.target ollama.service
      Wants=network-online.target

      [Service]
      Type=simple
      User=ii-agent
      Group=ii-agent
      WorkingDirectory=/var/lib/ii-agent
      EnvironmentFile=/etc/ii-agent/env
      ExecStart=/usr/local/bin/ii-agent serve
      Restart=on-failure
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  - path: /etc/ii-agent/env
    permissions: "0600"
    owner: "ii-agent:ii-agent"
    content: |
      # ii-agent environment — secrets injected at runtime
      II_AGENT_BACKEND=anthropic
      # II_AGENT_API_KEY resolved from secret: ANTHROPIC_API_KEY
      II_AGENT_API_KEY=ANTHROPIC_API_KEY}}
{% endif %}

{% for file in extra_files | default(value=[]) %}
  - path: {{ file.path }}
    permissions: ""
    owner: ""
{% if file.content is defined %}
    content: |

{% endif %}
{% if file.secret_ref is defined %}
    content: "{{secret:{{ file.secret_ref }}}}"
{% endif %}
{% endfor %}

# ─── runcmd — executed once in order ──────────────────────────────────────────
runcmd:
  # Datadog Agent install
  - ["sh", "-c", "DD_API_KEY=$(cat /run/secrets/dd_api_key 2>/dev/null || echo $DD_API_KEY) DD_SITE=datadoghq.com bash -c \"$(curl -L https://install.datadoghq.com/scripts/install_script_agent7.sh)\""]

  # Create ollama user/group and install ollama
  - useradd -r -s /bin/false -d /var/lib/ollama -m ollama
  - ["sh", "-c", "curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION=latest sh"]
  - systemctl daemon-reload
  - systemctl enable --now ollama.service

{% if ollama_models is defined and ollama_models | length > 0 %}
  # Pull ollama models on first boot
  - systemctl is-active --quiet ollama || (sleep 5 && systemctl start ollama)
  - ["sh", "-c", "ollama pull llama3.2:3b || true"]
  - ["sh", "-c", "ollama pull nomic-embed-text || true"]
  - ["sh", "-c", "ollama pull qwen2.5:0.5b || true"]

{% endif %}

{% if ii_agent_enabled | default(value=false) %}
  # Install ii-agent
  - useradd -r -s /bin/false -d /var/lib/ii-agent -m ii-agent
  - mkdir -p /etc/ii-agent
  - ["sh", "-c", "curl -fsSL https://github.com/anthropics/ii-agent/releases/download/latest/ii-agent-linux-$(uname -m).tar.gz | tar -xz -C /usr/local/bin/"]
  - systemctl daemon-reload
  - systemctl enable --now ii-agent.service
{% endif %}

{% if ac_client_enabled | default(value=false) %}
  # Install Anthropic Claude CLI client
  - npm install -g @anthropic-ai/claude-code@latest || pip3 install claude-code==
{% endif %}

  # Enable Datadog Agent
  - systemctl enable --now datadog-agent

  # Signal cloud-init completion
  - ["sh", "-c", "echo 'genoa first-boot complete: ai-assistant-edge-v1' >> /var/log/genoa-boot.log"]

# ─── Final message ─────────────────────────────────────────────────────────────
final_message: |
  genoa image ai-assistant-edge-v1 first-boot complete.
  Stack: datadog=true ollama=true ii-agent=true
  Up after $UPTIME seconds.