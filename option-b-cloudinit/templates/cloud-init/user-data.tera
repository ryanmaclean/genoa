#cloud-config
# Generated by genoa v1 — DO NOT EDIT
# Template: templates/cloud-init/user-data.tera
# Manifest: {{ manifest_id }}
#
# IMPORTANT — NoCloud datasource cache:
# cloud-init caches per-datasource. The instance-id in meta-data drives
# re-execution. genoa sets instance-id = sha256(manifest_toml) so every
# distinct manifest produces a distinct instance-id, forcing re-run.
# Merely bumping kernel cmdline / re-mounting the seed ISO does NOT
# invalidate the cache if instance-id is unchanged.
# Ref: https://cloudinit.readthedocs.io/en/latest/reference/datasources/nocloud.html

hostname: {{ hostname }}
fqdn: {{ hostname }}.local
manage_etc_hosts: true
locale: {{ locale | default(value="en_US.UTF-8") }}
timezone: {{ timezone | default(value="UTC") }}

# ─── Users ────────────────────────────────────────────────────────────────────
users:
  - name: root
    lock_passwd: true
{% for user in users %}
  - name: {{ user.name }}
    gecos: {{ user.gecos | default(value=user.name) }}
    groups: [{{ user.groups | default(value=["sudo", "docker"]) | join(sep=", ") }}]
    shell: {{ user.shell | default(value="/bin/bash") }}
    sudo: "{{ user.sudo | default(value="ALL=(ALL) NOPASSWD:ALL") }}"
    lock_passwd: true
{% if user.ssh_authorized_keys is defined %}
    ssh_authorized_keys:
{% for key in user.ssh_authorized_keys %}
      - {{ key }}
{% endfor %}
{% endif %}
{% if user.ssh_keys_secret_ref is defined %}
    # SSH keys from secret: {{ user.ssh_keys_secret_ref }}
    # Resolved at runtime by genoa seed-iso builder — never inlined here
    ssh_authorized_keys: {{ "{{" }}secret:{{ user.ssh_keys_secret_ref }}{{ "}}" }}
{% endif %}
{% endfor %}

# ─── Package management ────────────────────────────────────────────────────────
package_update: true
package_upgrade: true
packages:
  - curl
  - ca-certificates
  - gnupg
  - jq
  - git
{% for pkg in extra_packages | default(value=[]) %}
  - {{ pkg }}
{% endfor %}

# ─── Write files ───────────────────────────────────────────────────────────────
write_files:
  - path: /etc/genoa-manifest-id
    content: "{{ manifest_id }}\n"
    permissions: "0644"
    owner: root:root

  - path: /etc/datadog-agent/datadog.yaml
    permissions: "0640"
    owner: "root:dd-agent"
    # DD_API_KEY is resolved from secret: {{ dd_api_key_secret_ref | default(value="DD_API_KEY") }}
    # Never inlined — injected by systemd EnvironmentFile or secrets manager
    content: |
      api_key: "{{secret:{{ dd_api_key_secret_ref | default(value="DD_API_KEY") }}}}"
      site: {{ dd_site | default(value="datadoghq.com") }}
      hostname: {{ hostname }}
      tags:
{% for tag in dd_tags | default(value=["env:edge", "managed-by:genoa"]) %}
        - "{{ tag }}"
{% endfor %}
      logs_enabled: true
      apm_config:
        enabled: true
      process_config:
        enabled: true

  - path: /etc/systemd/system/ollama.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Ollama LLM runtime
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=ollama
      Group=ollama
      ExecStart=/usr/local/bin/ollama serve
      Restart=always
      RestartSec=3
      Environment="OLLAMA_HOST={{ ollama_host | default(value="0.0.0.0:11434") }}"
      Environment="OLLAMA_KEEP_ALIVE=24h"
      Environment="HOME=/var/lib/ollama"

      [Install]
      WantedBy=multi-user.target

{% if ii_agent_enabled | default(value=false) %}
  - path: /etc/systemd/system/ii-agent.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=ii-agent autonomous agent runtime
      After=network-online.target ollama.service
      Wants=network-online.target

      [Service]
      Type=simple
      User=ii-agent
      Group=ii-agent
      WorkingDirectory=/var/lib/ii-agent
      EnvironmentFile=/etc/ii-agent/env
      ExecStart=/usr/local/bin/ii-agent serve
      Restart=on-failure
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  - path: /etc/ii-agent/env
    permissions: "0600"
    owner: "ii-agent:ii-agent"
    content: |
      # ii-agent environment — secrets injected at runtime
      II_AGENT_BACKEND={{ ii_agent_backend | default(value="anthropic") }}
      # II_AGENT_API_KEY resolved from secret: {{ ii_agent_api_key_secret_ref | default(value="II_AGENT_API_KEY") }}
      II_AGENT_API_KEY={{secret:{{ ii_agent_api_key_secret_ref | default(value="II_AGENT_API_KEY") }}}}
{% endif %}

{% for file in extra_files | default(value=[]) %}
  - path: {{ file.path }}
    permissions: "{{ file.permissions | default(value="0644") }}"
    owner: "{{ file.owner | default(value="root:root") }}"
{% if file.content is defined %}
    content: |
{{ file.content | indent(prefix="      ") }}
{% endif %}
{% if file.secret_ref is defined %}
    content: "{{secret:{{ file.secret_ref }}}}"
{% endif %}
{% endfor %}

# ─── runcmd — executed once in order ──────────────────────────────────────────
runcmd:
  # Datadog Agent install
  - ["sh", "-c", "DD_API_KEY=$(cat /run/secrets/dd_api_key 2>/dev/null || echo $DD_API_KEY) DD_SITE={{ dd_site | default(value="datadoghq.com") }} bash -c \"$(curl -L https://install.datadoghq.com/scripts/install_script_agent7.sh)\""]

  # Create ollama user/group and install ollama
  - useradd -r -s /bin/false -d /var/lib/ollama -m ollama
  - ["sh", "-c", "curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION={{ ollama_version | default(value="latest") }} sh"]
  - systemctl daemon-reload
  - systemctl enable --now ollama.service

{% if ollama_models is defined and ollama_models | length > 0 %}
  # Pull ollama models on first boot
  - systemctl is-active --quiet ollama || (sleep 5 && systemctl start ollama)
{% for model in ollama_models %}
  - ["sh", "-c", "ollama pull {{ model }} || true"]
{% endfor %}
{% endif %}

{% if ii_agent_enabled | default(value=false) %}
  # Install ii-agent
  - useradd -r -s /bin/false -d /var/lib/ii-agent -m ii-agent
  - mkdir -p /etc/ii-agent
  - ["sh", "-c", "curl -fsSL https://github.com/anthropics/ii-agent/releases/download/{{ ii_agent_version | default(value="latest") }}/ii-agent-linux-$(uname -m).tar.gz | tar -xz -C /usr/local/bin/"]
  - systemctl daemon-reload
  - systemctl enable --now ii-agent.service
{% endif %}

{% if ac_client_enabled | default(value=false) %}
  # Install Anthropic Claude CLI client
  - npm install -g @anthropic-ai/claude-code@{{ ac_client_version | default(value="latest") }} || pip3 install claude-code=={{ ac_client_version | default(value="latest") }}
{% endif %}

  # Enable Datadog Agent
  - systemctl enable --now datadog-agent

  # Signal cloud-init completion
  - ["sh", "-c", "echo 'genoa first-boot complete: {{ manifest_id }}' >> /var/log/genoa-boot.log"]

# ─── Final message ─────────────────────────────────────────────────────────────
final_message: |
  genoa image {{ manifest_id }} first-boot complete.
  Stack: datadog={{ dd_enabled | default(value=true) }} ollama={{ ollama_enabled | default(value=true) }} ii-agent={{ ii_agent_enabled | default(value=false) }}
  Up after $UPTIME seconds.
