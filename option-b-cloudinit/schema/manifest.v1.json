{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genoa.dev/schema/manifest/v1",
  "title": "Genoa Cloud Image Manifest v1",
  "description": "Schema for genoa cloud-init image baker manifests. Secrets are always referenced by name, never inlined.",
  "type": "object",
  "required": ["genoa", "image", "stack"],
  "additionalProperties": false,
  "properties": {
    "genoa": {
      "type": "object",
      "description": "Manifest metadata and schema version",
      "required": ["schema_version", "manifest_id", "created_at"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "v1",
          "description": "Schema version — always 'v1' for this schema"
        },
        "manifest_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}[a-z0-9]$",
          "description": "Stable, URL-safe manifest identifier"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 creation timestamp"
        },
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "image": {
      "type": "object",
      "description": "Base image configuration",
      "required": ["base", "arch"],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "enum": ["alpine-3.20", "debian-bookworm", "ubuntu-noble", "fedora-40"],
          "description": "Base distribution identifier"
        },
        "arch": {
          "type": "string",
          "enum": ["aarch64", "x86_64", "armv7l"],
          "description": "Target CPU architecture"
        },
        "base_image_uri": {
          "type": "string",
          "format": "uri",
          "description": "Explicit OCI/HTTP URI for the base image (optional; resolved from catalog if omitted)"
        },
        "base_image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Expected sha256 digest of the base image for verification"
        },
        "hostname": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
          "description": "Cloud-init hostname for the instance"
        },
        "locale": {
          "type": "string",
          "default": "en_US.UTF-8"
        },
        "timezone": {
          "type": "string",
          "default": "UTC",
          "description": "Olson timezone identifier"
        }
      }
    },
    "stack": {
      "type": "object",
      "description": "AI assistant and agent stack components to pre-bake",
      "additionalProperties": false,
      "properties": {
        "datadog_agent": {
          "type": "object",
          "description": "Datadog Agent configuration",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "version": {
              "type": "string",
              "default": "latest",
              "description": "Datadog Agent version (e.g. '7' or '7.52.0')"
            },
            "api_key_secret_ref": {
              "type": "string",
              "description": "Secret name holding DD_API_KEY. Never inline the key here.",
              "pattern": "^[A-Z0-9_]+$"
            },
            "site": {
              "type": "string",
              "default": "datadoghq.com",
              "description": "Datadog intake site"
            },
            "tags": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-zA-Z0-9_./-]+:[a-zA-Z0-9_./-]+$" },
              "description": "Static tags applied to all metrics/traces"
            },
            "integrations": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Integration check names to enable (e.g. 'ollama', 'process')"
            }
          }
        },
        "ollama": {
          "type": "object",
          "description": "Ollama LLM runtime",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "version": {
              "type": "string",
              "default": "latest"
            },
            "models": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Model tags to pull on first boot (e.g. ['llama3.2:3b', 'nomic-embed-text'])"
            },
            "host": {
              "type": "string",
              "default": "0.0.0.0:11434"
            },
            "gpu": {
              "type": "string",
              "enum": ["auto", "none", "cuda", "metal", "rocm"],
              "default": "auto"
            }
          }
        },
        "ii_agent": {
          "type": "object",
          "description": "ii-agent autonomous agent runtime",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "version": { "type": "string", "default": "latest" },
            "backend": {
              "type": "string",
              "enum": ["anthropic", "openai", "ollama", "bedrock"],
              "default": "anthropic"
            },
            "api_key_secret_ref": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$",
              "description": "Secret name for the LLM API key. Never inline."
            }
          }
        },
        "ac_client": {
          "type": "object",
          "description": "Anthropic Claude CLI client",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "version": { "type": "string", "default": "latest" }
          }
        },
        "extra_packages": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional distro packages to install via package manager"
        },
        "extra_files": {
          "type": "array",
          "description": "Verbatim files to write on first boot (content inline or from secret_ref)",
          "items": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "content": { "type": "string" },
              "secret_ref": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$",
                "description": "Secret name — resolved at runtime, not bake time"
              },
              "permissions": { "type": "string", "pattern": "^[0-7]{3,4}$", "default": "644" },
              "owner": { "type": "string", "default": "root:root" }
            }
          }
        }
      }
    },
    "users": {
      "type": "array",
      "description": "Cloud-init users to create",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "gecos": { "type": "string" },
          "groups": {
            "type": "array",
            "items": { "type": "string" }
          },
          "shell": { "type": "string", "default": "/bin/bash" },
          "sudo": { "type": "string", "default": "ALL=(ALL) NOPASSWD:ALL" },
          "ssh_authorized_keys": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(ssh-|ecdsa-|sk-)" },
            "description": "Public keys only — never private keys"
          },
          "ssh_keys_secret_ref": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$",
            "description": "Secret name resolving to newline-delimited authorized_keys"
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "description": "Per-target output configuration. Keys are target names.",
      "additionalProperties": false,
      "properties": {
        "qcow2": {
          "$ref": "#/$defs/target_common"
        },
        "aws": {
          "allOf": [
            { "$ref": "#/$defs/target_common" },
            {
              "properties": {
                "region": { "type": "string", "default": "us-east-1" },
                "ami_name": { "type": "string" },
                "s3_bucket_secret_ref": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
                "virtualization_type": { "type": "string", "enum": ["hvm", "paravirtual"], "default": "hvm" },
                "root_device_name": { "type": "string", "default": "/dev/xvda" }
              }
            }
          ]
        },
        "gcp": {
          "allOf": [
            { "$ref": "#/$defs/target_common" },
            {
              "properties": {
                "project_id": { "type": "string" },
                "family": { "type": "string" },
                "storage_location": { "type": "string", "default": "us" },
                "service_account_secret_ref": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
              }
            }
          ]
        },
        "do": {
          "allOf": [
            { "$ref": "#/$defs/target_common" },
            {
              "properties": {
                "region": { "type": "string", "default": "nyc3" },
                "spaces_bucket_secret_ref": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
                "token_secret_ref": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
              }
            }
          ]
        },
        "pi": {
          "allOf": [
            { "$ref": "#/$defs/target_common" },
            {
              "properties": {
                "pi_model": {
                  "type": "string",
                  "enum": ["pi4", "pi5", "pi-zero2w"],
                  "default": "pi5"
                },
                "boot_partition_size_mb": { "type": "integer", "default": 256 }
              }
            }
          ]
        },
        "raw": {
          "$ref": "#/$defs/target_common"
        }
      }
    },
    "secrets": {
      "type": "object",
      "description": "Secret resolution configuration — declares how to resolve secret_ref names at runtime",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["env", "aws-secrets-manager", "hashicorp-vault", "gcp-secret-manager", "file"],
          "default": "env",
          "description": "Secret backend. 'env' reads from environment variables at build time."
        },
        "vault_addr": { "type": "string", "format": "uri" },
        "vault_path_prefix": { "type": "string" },
        "aws_region": { "type": "string" },
        "gcp_project": { "type": "string" }
      }
    }
  },
  "$defs": {
    "target_common": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "disk_size_gb": { "type": "integer", "minimum": 2, "default": 10 },
        "output_path": { "type": "string" },
        "compress": { "type": "boolean", "default": false }
      }
    }
  }
}
