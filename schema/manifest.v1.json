{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ryanmaclean/genoa/schema/manifest.v1.json",
  "title": "genoa manifest v1",
  "description": "Schema for genoa cloud image build manifests. AX-first: structured I/O, versioned, machine-discoverable. Profile 'microvm' describes a direct-kernel (PVH) boot artifact plus independently hashable writable state disks (genoa issue #1).",
  "type": "object",
  "required": ["schema_version", "image", "target", "kernel"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1",
      "description": "Schema version identifier. Must be 'v1'."
    },
    "profile": {
      "type": "string",
      "enum": ["uefi", "kboot", "netbsd", "microvm"],
      "default": "uefi",
      "description": "Build profile."
    },
    "image": {
      "type": "object",
      "required": ["name", "version", "format"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"},
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "format": {
          "type": "string",
          "enum": ["raw", "vmdk", "vhd", "qcow2", "elf"],
          "description": "Artifact format. 'elf' = one PVH-bootable kernel ELF (microvm profile only)."
        },
        "size_mb": {"type": "integer", "minimum": 512, "maximum": 65536},
        "output_dir": {"type": "string", "default": "./out"},
        "description": {"type": "string", "maxLength": 256}
      }
    },
    "target": {
      "type": "object",
      "required": ["os", "os_version", "arch"],
      "additionalProperties": false,
      "properties": {
        "os": {"type": "string", "enum": ["freebsd", "netbsd"]},
        "os_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-RELEASE(-p[0-9]+)?)?$"},
        "arch": {"type": "string", "enum": ["amd64", "aarch64", "riscv64"]},
        "platform": {"type": "string", "default": "generic"}
      }
    },
    "kernel": {
      "type": "object",
      "required": ["config"],
      "additionalProperties": false,
      "properties": {
        "config": {"type": "string"},
        "strip_debug": {"type": "boolean", "default": true},
        "artifact": {
          "type": "object",
          "description": "microvm: pre-built boot artifact (e.g. smolfire's one-ELF kernel with embedded MFS root, or NetBSD 11 netbsd-MICROVM). genoa packages, hashes and attests it; the OS build itself is owned by smolfire.",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["local_path", "url"]},
            "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
            "url": {"type": "string", "format": "uri"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "version": {
              "type": "string",
              "description": "Kernel/runtime version string recorded in the receipt, e.g. '15.0-RELEASE SMOLFIRE' or '11.0 MICROVM'."
            }
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"include": {"type": "array", "items": {"type": "string"}}}
    },
    "agent": {
      "type": "object",
      "required": ["name", "version", "source"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "source": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["url", "gitea_release", "local_path"]},
            "url": {"type": "string", "format": "uri"},
            "path": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "rc_service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"}}
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface": {"type": "string"},
        "mode": {"type": "string", "enum": ["dhcp", "static"], "default": "dhcp"},
        "hostname": {"type": "string"},
        "ssh_keys": {"type": "array", "items": {"type": "string"}}
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "enum": ["vultr", "linode_akamai", "aws_ec2", "gce_gcp"]},
        "region": {"type": "string"},
        "plan": {"type": "string"},
        "linode_id": {"type": ["integer", "null"]}
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "string", "enum": ["signify", "minisign", "openssl", "none"], "default": "none"},
        "key_path": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object",
      "description": "Freeform metadata. Not validated.",
      "additionalProperties": true
    },
    "boot": {
      "type": "object",
      "description": "Boot contract. Required when profile = microvm.",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["direct-kernel", "uefi", "kboot"]},
        "protocol": {"type": "string", "enum": ["pvh"], "default": "pvh"},
        "vmm": {
          "type": "array",
          "items": {"type": "string", "enum": ["firecracker", "qemu-microvm"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "cmdline": {"type": "string", "maxLength": 1024},
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 65536, "default": 512},
        "vcpus": {"type": "integer", "minimum": 1, "maximum": 64, "default": 1},
        "ready_marker": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,64}$",
          "description": "Serial-console line the guest prints when ready (e.g. SMOLFIRE_READY)."
        }
      }
    },
    "rootfs": {
      "type": "object",
      "description": "Immutable root for the microvm. 'embedded' = root is inside the kernel ELF (no root disk). 'image' = a separate immutable ramdisk/rootfs file.",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["embedded", "image"]},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "device": {"type": "string", "pattern": "^[a-z0-9]{1,16}$"}
      }
    },
    "state_disks": {
      "type": "array",
      "description": "Writable state volumes, independent from the immutable boot artifact. Each is hashed separately in the receipt.",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["name", "fs", "size_mb"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"},
          "fs": {"type": "string", "enum": ["ffs", "lfs", "hammer2", "hammer1"]},
          "size_mb": {"type": "integer", "minimum": 16, "maximum": 1048576},
          "label": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,16}$"},
          "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "device": {"type": "string", "pattern": "^[a-z0-9]{1,16}$"},
          "mountpoint": {"type": "string", "pattern": "^/[A-Za-z0-9._/-]*$"},
          "journal": {"type": "boolean", "description": "ffs: SU+J on FreeBSD, WAPBL (-o log) on NetBSD."}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"profile": {"const": "microvm"}},
        "required": ["profile"]
      },
      "then": {
        "required": ["boot"],
        "properties": {
          "image": {
            "properties": {"format": {"const": "elf"}}
          },
          "boot": {
            "properties": {"mode": {"const": "direct-kernel"}}
          },
          "kernel": {"required": ["config", "artifact"]}
        }
      },
      "else": {
        "required": ["agent"],
        "properties": {
          "image": {
            "required": ["size_mb"],
            "properties": {"format": {"not": {"const": "elf"}}}
          }
        }
      }
    }
  ]
}
