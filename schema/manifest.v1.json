{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ryanmaclean/genoa/schema/manifest.v1.json",
  "title": "genoa manifest v1",
  "description": "Schema for genoa cloud image build manifests. AX-first: structured I/O, versioned, machine-discoverable.",
  "type": "object",
  "required": ["schema_version", "image", "target", "kernel", "agent"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1",
      "description": "Schema version identifier. Must be 'v1'."
    },
    "profile": {
      "type": "string",
      "enum": ["uefi", "kboot"],
      "default": "uefi",
      "description": "Build profile. 'uefi' for GPT+FAT32+UFS2 FreeBSD images. 'kboot' for ext4-boot providers (GCE, Linode)."
    },
    "image": {
      "type": "object",
      "required": ["name", "version", "format", "size_mb"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
          "description": "Image name slug. Lowercase alphanumeric with hyphens. Used in output filename."
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version string (vN.N.N)."
        },
        "format": {
          "type": "string",
          "enum": ["raw", "vmdk", "vhd", "qcow2"],
          "description": "Output image format. 'raw' is supported for all providers."
        },
        "size_mb": {
          "type": "integer",
          "minimum": 512,
          "maximum": 65536,
          "description": "Image size in megabytes. Minimum 512. Must accommodate base system + agent."
        },
        "output_dir": {
          "type": "string",
          "default": "./out",
          "description": "Directory for output image file. Relative to repo root."
        },
        "description": {
          "type": "string",
          "maxLength": 256,
          "description": "Human-readable description of this image."
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["os", "os_version", "arch"],
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "enum": ["freebsd", "netbsd"],
          "description": "Target operating system."
        },
        "os_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+-RELEASE(-p[0-9]+)?$",
          "description": "OS release version (e.g. '15.0-RELEASE', '15.0-RELEASE-p5')."
        },
        "arch": {
          "type": "string",
          "enum": ["amd64", "aarch64", "riscv64"],
          "description": "Target CPU architecture."
        },
        "platform": {
          "type": "string",
          "default": "generic",
          "description": "Target platform hint. 'generic' for most cloud providers."
        },
        "build_host": {
          "type": "string",
          "description": "Optional SSH destination for remote build (e.g. 'builder@fb-vm-24:2225'). Omit to build locally."
        }
      }
    },
    "kernel": {
      "type": "object",
      "required": ["config"],
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "string",
          "description": "Kernel configuration name (e.g. 'GENERIC')."
        },
        "strip_debug": {
          "type": "boolean",
          "default": true,
          "description": "Strip debug symbols from kernel to reduce image size."
        },
        "kernel_delta_file": {
          "type": "string",
          "description": "Optional path to a kernel config delta file. Relative to manifest location."
        },
        "extra_options": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(no)?(device|options|makeoptions)\\s+\\S.*$"
          },
          "description": "Additional nodevice/nooptions/options lines injected into the kernel config."
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of pkg(8) package names to install."
        },
        "exclude_patterns": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Glob patterns to exclude from package set."
        },
        "pkg_repo": {
          "type": "string",
          "description": "pkg repository URL."
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["name", "version", "source"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Agent binary name (e.g. 'ii-agent')."
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Agent semantic version."
        },
        "source": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["url", "gitea_release", "local_path"],
              "description": "How to obtain the agent binary."
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "URL to download agent binary from (when type=url)."
            },
            "path": {
              "type": "string",
              "description": "Local filesystem path to agent binary (when type=local_path)."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$",
              "description": "SHA256 hex digest of agent binary for verification."
            },
            "repo": {
              "type": "string",
              "description": "Gitea repo path 'owner/name' (used when type=gitea_release)."
            },
            "tag": {
              "type": "string",
              "description": "Release tag (used when type=gitea_release)."
            },
            "asset": {
              "type": "string",
              "description": "Asset filename within the Gitea release."
            }
          }
        },
        "install_path": {
          "type": "string",
          "default": "/usr/local/bin",
          "description": "Absolute path inside the image where the agent binary is installed."
        },
        "rc_service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,31}$",
              "description": "rc.d service name (lowercase, underscores allowed)."
            },
            "command_args": {
              "type": "string",
              "description": "Arguments passed to the agent binary when started by rc.d."
            }
          }
        },
        "config": {
          "type": "object",
          "description": "Agent-specific configuration key/value pairs baked into the image.",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface": {
          "type": "string",
          "description": "Primary network interface name (e.g. 'vtnet0', 'eth0', 'ena0')."
        },
        "mode": {
          "type": "string",
          "enum": ["dhcp", "static"],
          "default": "dhcp"
        },
        "hostname": {
          "type": "string",
          "description": "Hostname for the built image."
        },
        "ssh_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SSH public keys to authorize for root login."
        },
        "static_ip": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$",
          "description": "IP/prefix in CIDR notation (used when mode=static)."
        },
        "gateway": {
          "type": "string",
          "description": "Default gateway (used when mode=static)."
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["vultr", "linode_akamai", "aws_ec2", "gce_gcp"],
          "description": "Cloud provider to deploy to."
        },
        "region": {
          "type": "string",
          "description": "Provider region identifier."
        },
        "plan": {
          "type": "string",
          "description": "Provider instance plan/size identifier."
        },
        "linode_id": {
          "type": ["integer", "null"],
          "description": "Linode instance ID (required for rescue-dd deployment)."
        },
        "path_override": {
          "type": "string",
          "description": "Optional override of the deployment_path from catalog."
        },
        "oci_availability_domain": {
          "type": "string",
          "description": "OCI availability domain for instance launch."
        },
        "oci_namespace": {
          "type": "string",
          "description": "OCI Object Storage namespace."
        },
        "oci_bucket": {
          "type": "string",
          "description": "OCI Object Storage bucket name."
        },
        "oci_compartment_id": {
          "type": "string",
          "description": "OCI compartment OCID."
        },
        "oci_subnet_id": {
          "type": "string",
          "description": "OCI subnet OCID for instance launch."
        },
        "oci_shape": {
          "type": "string",
          "description": "OCI compute shape."
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "enum": ["signify", "minisign", "openssl", "none"],
          "default": "none"
        },
        "key_path": {
          "type": "string",
          "description": "Path to signing key file."
        },
        "key_file": {
          "type": "string",
          "description": "Path to signify private key file (.sec)."
        },
        "public_key_file": {
          "type": "string",
          "description": "Path to signify public key file (.pub)."
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Freeform metadata for human notes. Not validated.",
      "additionalProperties": true
    }
  }
}
