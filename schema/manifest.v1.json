{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ryanmaclean/genoa/schema/manifest.v1.json",
  "title": "genoa manifest v1",
  "description": "Schema for genoa cloud image build manifests. AX-first: structured I/O, versioned, machine-discoverable.",
  "type": "object",
  "required": ["schema_version", "image", "target", "kernel", "agent"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1",
      "description": "Schema version identifier. Must be 'v1'."
    },
    "profile": {
      "type": "string",
      "enum": ["uefi", "kboot", "netbsd"],
      "default": "uefi",
      "description": "Build profile."
    },
    "image": {
      "type": "object",
      "required": ["name", "version", "format", "size_mb"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"},
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "format": {"type": "string", "enum": ["raw", "vmdk", "vhd", "qcow2"]},
        "size_mb": {"type": "integer", "minimum": 512, "maximum": 65536},
        "output_dir": {"type": "string", "default": "./out"},
        "description": {"type": "string", "maxLength": 256}
      }
    },
    "target": {
      "type": "object",
      "required": ["os", "os_version", "arch"],
      "additionalProperties": false,
      "properties": {
        "os": {"type": "string", "enum": ["freebsd", "netbsd"]},
        "os_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-RELEASE(-p[0-9]+)?)?$"},
        "arch": {"type": "string", "enum": ["amd64", "aarch64", "riscv64"]},
        "platform": {"type": "string", "default": "generic"}
      }
    },
    "kernel": {
      "type": "object",
      "required": ["config"],
      "additionalProperties": false,
      "properties": {
        "config": {"type": "string"},
        "strip_debug": {"type": "boolean", "default": true}
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {"type": "array", "items": {"type": "string"}}
      }
    },
    "agent": {
      "type": "object",
      "required": ["name", "version", "source"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "source": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["url", "gitea_release", "local_path"]},
            "url": {"type": "string", "format": "uri"},
            "path": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "rc_service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"}
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface": {"type": "string"},
        "mode": {"type": "string", "enum": ["dhcp", "static"], "default": "dhcp"},
        "hostname": {"type": "string"},
        "ssh_keys": {"type": "array", "items": {"type": "string"}}
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "enum": ["vultr", "linode_akamai", "aws_ec2", "gce_gcp"]},
        "region": {"type": "string"},
        "plan": {"type": "string"},
        "linode_id": {"type": ["integer", "null"]}
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "string", "enum": ["signify", "minisign", "openssl", "none"], "default": "none"},
        "key_path": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object",
      "description": "Freeform metadata. Not validated.",
      "additionalProperties": true
    }
  }
}
