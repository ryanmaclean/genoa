#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-2-Clause
#
# bootstrap.sh — LSD Linux→QEMU→mfsBSD trampoline installer
# Generated by lsd build from manifest: {{ manifest_path }}
# Built at: {{ built_at }}
#
# This script runs inside the provider's Linux rescue environment.
# It installs QEMU, verifies the mfsBSD ISO, and boots it with the
# cloud disk passed through so mfsBSD can install FreeBSD directly.
#
# Supported rescue environments: Debian 11/12, Ubuntu 22.04/24.04, Alpine 3.x
#
# Variables rendered by lsd build (Tera template):
#   {{ mfsbsd_url }}        — URL to fetch mfsBSD ISO
#   {{ mfsbsd_sha256 }}     — expected SHA-256 of the ISO
#   {{ target_disk }}       — block device to pass to QEMU (e.g. /dev/sda)
#   {{ bsd_hostname }}      — hostname for the installed BSD
#   {{ ssh_authorized_keys }} — newline-separated SSH public keys
#   {{ arch }}              — amd64 | aarch64
#   {{ callback_url }}      — optional POST-on-success URL (empty string = skip)
#   {{ qemu_machine }}      — QEMU -M argument (e.g. "virt,accel=kvm" for ARM64)
#   {{ qemu_cpu }}          — QEMU -cpu argument (e.g. "host" or "max")
#   {{ imds_endpoint }}     — provider IMDS base URL (for runtime key injection fallback)

set -euo pipefail

LSD_VERSION="0.1.0"
MFS_URL="{{ mfsbsd_url }}"
MFS_SHA256="{{ mfsbsd_sha256 }}"
TARGET_DISK="{{ target_disk }}"
BSD_HOSTNAME="{{ bsd_hostname }}"
ARCH="{{ arch }}"
CALLBACK_URL="{{ callback_url }}"
QEMU_MACHINE="{{ qemu_machine }}"
QEMU_CPU="{{ qemu_cpu }}"

# SSH keys will be written to a temp VFAT image and passed to mfsBSD as a CD-ROM
SSH_AUTHORIZED_KEYS='{{ ssh_authorized_keys }}'

ISO_PATH="/tmp/mfsbsd.iso"
SEED_IMG="/tmp/lsd-seed.img"
SEED_MNT="/tmp/lsd-seed-mnt"
BSDINSTALL_SCRIPT="/tmp/bsdinstall.script"

log() { printf '[lsd] %s\n' "$*" >&2; }
die() { log "FATAL: $*"; exit 1; }

# ── 0. Sanity checks ──────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || die "Must run as root"
[[ -b "$TARGET_DISK" ]] || die "Target disk $TARGET_DISK is not a block device"

# ── 1. Detect distro and install QEMU ────────────────────────────────────────
detect_and_install_qemu() {
    log "Detecting rescue distro..."
    if command -v apt-get &>/dev/null; then
        log "Detected Debian/Ubuntu — installing qemu-system via apt"
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        if [[ "$ARCH" == "aarch64" ]]; then
            apt-get install -y -qq qemu-system-arm qemu-utils ovmf
            QEMU_BIN="qemu-system-aarch64"
        else
            apt-get install -y -qq qemu-system-x86 qemu-utils ovmf
            QEMU_BIN="qemu-system-x86_64"
        fi
    elif command -v apk &>/dev/null; then
        log "Detected Alpine — installing qemu via apk"
        apk add --no-progress qemu qemu-img
        if [[ "$ARCH" == "aarch64" ]]; then
            apk add --no-progress qemu-system-aarch64
            QEMU_BIN="qemu-system-aarch64"
        else
            apk add --no-progress qemu-system-x86_64
            QEMU_BIN="qemu-system-x86_64"
        fi
    elif command -v yum &>/dev/null; then
        log "Detected RHEL/CentOS — installing qemu-kvm via yum"
        yum install -y -q qemu-kvm qemu-img
        QEMU_BIN="qemu-kvm"
    else
        die "Unknown rescue distro; cannot install QEMU automatically"
    fi
    log "QEMU binary: $QEMU_BIN"
    export QEMU_BIN
}

# ── 2. Fetch and verify mfsBSD ISO ───────────────────────────────────────────
fetch_and_verify_iso() {
    log "Fetching mfsBSD ISO from: $MFS_URL"
    if command -v curl &>/dev/null; then
        curl -fsSL --retry 3 --retry-delay 5 -o "$ISO_PATH" "$MFS_URL"
    elif command -v wget &>/dev/null; then
        wget -q --tries=3 -O "$ISO_PATH" "$MFS_URL"
    else
        die "Neither curl nor wget found in rescue environment"
    fi

    log "Verifying sha256..."
    ACTUAL_SHA256=$(sha256sum "$ISO_PATH" | awk '{print $1}')
    if [[ "$ACTUAL_SHA256" != "$MFS_SHA256" ]]; then
        die "SHA-256 mismatch! expected=$MFS_SHA256 got=$ACTUAL_SHA256"
    fi
    log "ISO verified: $ACTUAL_SHA256"
}

# ── 3. Build seed image with SSH keys + bsdinstall script ─────────────────────
build_seed_image() {
    log "Building seed VFAT image with SSH keys and bsdinstall script..."

    # Write bsdinstall script (also rendered from template at build time)
    cat > "$BSDINSTALL_SCRIPT" << 'BSDINSTALL_EOF'
{{ bsdinstall_script_inline }}
BSDINSTALL_EOF

    # Create a small VFAT image to pass as a second CD-ROM
    dd if=/dev/zero of="$SEED_IMG" bs=1M count=8 2>/dev/null
    mkfs.vfat "$SEED_IMG"
    mkdir -p "$SEED_MNT"
    mount -o loop "$SEED_IMG" "$SEED_MNT"

    # Inject SSH keys
    mkdir -p "$SEED_MNT/root/.ssh"
    printf '%s\n' "$SSH_AUTHORIZED_KEYS" > "$SEED_MNT/root/.ssh/authorized_keys"
    chmod 700 "$SEED_MNT/root/.ssh"
    chmod 600 "$SEED_MNT/root/.ssh/authorized_keys"

    # Copy bsdinstall script
    cp "$BSDINSTALL_SCRIPT" "$SEED_MNT/bsdinstall.script"

    # Hostname hint
    printf '%s\n' "$BSD_HOSTNAME" > "$SEED_MNT/hostname"

    # DNS resolver seed for QEMU SLIRP user-mode networking.
    # mfsBSD may start bsdinstall before dhclient has written /etc/resolv.conf.
    # QEMU SLIRP DNS is always at 10.0.2.3; we write a resolv.conf hint into the
    # seed image. The mfsBSD autorun script should copy this before calling bsdinstall.
    # Without this, bsdinstall's "Fetching" step can hang silently waiting for DNS.
    # Reference: https://wiki.qemu.org/Documentation/Networking#User_Networking_(SLIRP)
    cat > "$SEED_MNT/resolv.conf.qemu-slirp" << 'RESOLV_EOF'
# QEMU SLIRP resolver — written by lsd bootstrap.sh
# Copy to /etc/resolv.conf inside mfsBSD before calling bsdinstall
nameserver 10.0.2.3
nameserver 1.1.1.1
RESOLV_EOF

    umount "$SEED_MNT"
    log "Seed image ready: $SEED_IMG"
}

# ── 4. Boot mfsBSD in QEMU with cloud disk passthrough ───────────────────────
boot_mfsbsd() {
    log "Starting QEMU with mfsBSD ISO and target disk passthrough..."
    log "  Machine:     $QEMU_MACHINE"
    log "  CPU:         $QEMU_CPU"
    log "  Target disk: $TARGET_DISK"
    log "  ISO:         $ISO_PATH"
    log "  Seed:        $SEED_IMG"

    # Check for KVM availability
    QEMU_ACCEL_FLAGS=""
    if [[ -c /dev/kvm ]]; then
        log "KVM available — enabling hardware acceleration"
        QEMU_ACCEL_FLAGS="-enable-kvm"
    else
        log "WARNING: KVM not available — QEMU will run in software emulation (slow)"
    fi

    # aarch64 needs UEFI firmware
    QEMU_FIRMWARE_FLAGS=""
    if [[ "$ARCH" == "aarch64" ]]; then
        # Try standard OVMF locations
        for fw_path in \
            /usr/share/AAVMF/AAVMF_CODE.fd \
            /usr/share/qemu/OVMF.fd \
            /usr/share/edk2/aarch64/QEMU_EFI.fd; do
            if [[ -f "$fw_path" ]]; then
                QEMU_FIRMWARE_FLAGS="-bios $fw_path"
                log "Using UEFI firmware: $fw_path"
                break
            fi
        done
        if [[ -z "$QEMU_FIRMWARE_FLAGS" ]]; then
            log "WARNING: No UEFI firmware found for aarch64 — boot may fail"
        fi
    fi

    # mfsBSD boots, runs bsdinstall from /bsdinstall.script on the seed volume.
    # The target disk is passed as virtio-blk so mfsBSD sees it as /dev/vtbd0.
    # We use -nographic + serial console so output is captured.
    #
    # NETWORKING INSIDE QEMU (SLIRP user-mode):
    #   QEMU -netdev user assigns 10.0.2.x to the guest via DHCP.
    #   DNS resolver is 10.0.2.3 (QEMU built-in). Outbound TCP/UDP works.
    #   There is NO inbound connectivity from the rescue host to the guest —
    #   you cannot SSH into the QEMU guest while it is running.
    #
    #   IMPORTANT: bsdinstall fetches FreeBSD distribution sets (.txz) over HTTPS
    #   from download.freebsd.org. This works over SLIRP. However:
    #   - If mfsBSD does not run dhclient on vtnet0, DNS will not resolve and
    #     bsdinstall will hang silently at the "Fetching" step.
    #   - The bsdinstall.script resolver stanza below injects a resolver hint
    #     into the seed image so mfsBSD can reach DNS even before dhclient runs.
    #   - pkg(8) is NOT invoked by bsdinstall's base install — only .txz fetches.
    #     If you add a postinstall pkg step, it will also work over SLIRP, but
    #     FreeBSD under QEMU SLIRP has no inbound by default so pkg repos must be
    #     reachable outbound (they are, via SLIRP NAT).
    #   Reference: https://docs.freebsd.org/en/books/handbook/ports/
    #              https://wiki.qemu.org/Documentation/Networking#User_Networking_(SLIRP)
    "$QEMU_BIN" \
        -M "$QEMU_MACHINE" \
        -cpu "$QEMU_CPU" \
        $QEMU_ACCEL_FLAGS \
        $QEMU_FIRMWARE_FLAGS \
        -m 2048 \
        -smp 2 \
        -drive file="$TARGET_DISK",format=raw,if=virtio,cache=none \
        -drive file="$ISO_PATH",media=cdrom,if=virtio,readonly=on \
        -drive file="$SEED_IMG",media=cdrom,if=virtio,readonly=on \
        -netdev user,id=net0,dns=10.0.2.3 \
        -device virtio-net-pci,netdev=net0 \
        -serial stdio \
        -nographic \
        -no-reboot \
        2>&1 | tee /tmp/lsd-qemu.log

    QEMU_EXIT=${PIPESTATUS[0]}
    if [[ $QEMU_EXIT -ne 0 ]]; then
        log "QEMU exited with code $QEMU_EXIT — check /tmp/lsd-qemu.log"
        die "mfsBSD install failed"
    fi
    log "QEMU exited cleanly — install presumed successful"
}

# ── 5. Optional callback ──────────────────────────────────────────────────────
post_callback() {
    if [[ -z "$CALLBACK_URL" ]]; then
        log "No callback URL configured — skipping"
        return
    fi
    log "POSTing success notification to: $CALLBACK_URL"
    local payload
    payload=$(printf '{"status":"installed","hostname":"%s","disk":"%s","built_by":"lsd/%s"}' \
        "$BSD_HOSTNAME" "$TARGET_DISK" "$LSD_VERSION")
    curl -fsSL -X POST \
        -H "Content-Type: application/json" \
        -d "$payload" \
        "$CALLBACK_URL" || log "WARNING: callback POST failed (non-fatal)"
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
    log "LSD bootstrap v$LSD_VERSION starting"
    log "Target: $BSD_HOSTNAME on $TARGET_DISK ($ARCH)"
    detect_and_install_qemu
    fetch_and_verify_iso
    build_seed_image
    boot_mfsbsd
    post_callback
    log "Bootstrap complete. Reboot into BSD."
}

main "$@"
