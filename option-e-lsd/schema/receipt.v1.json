{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryanmaclean/genoa/option-e-lsd/schema/receipt.v1.json",
  "title": "LSD Build Receipt",
  "description": "Schema version 1.0.0 — provenance envelope emitted by lsd build",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "built_at", "manifest_sha256", "artifacts", "tool"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "built_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of build"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the input manifest file that produced this build"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "size_bytes", "role"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Filename of the artifact"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "enum": ["bootstrap-script", "bsdinstall-script", "manifest-copy", "other"],
            "description": "Semantic role of this artifact in the installer pipeline"
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "commit"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "description": "git commit SHA or 'unknown'"
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": ["sigstore", "gpg", "none"],
          "default": "none"
        },
        "signature": {
          "type": "string",
          "description": "Base64-encoded detached signature (if method != none)"
        },
        "signer_identity": {
          "type": "string",
          "description": "Email or key fingerprint of signer"
        }
      }
    },
    "trust_level": {
      "type": "string",
      "enum": ["unsigned", "self-signed", "cosign-verified", "slsa-l1", "slsa-l2", "slsa-l3"],
      "default": "unsigned",
      "description": "Explicit trust assertion — agents should reject receipts below their required level"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Non-fatal issues encountered during build that consumers should be aware of"
    }
  }
}
