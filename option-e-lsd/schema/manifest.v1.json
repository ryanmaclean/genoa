{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryanmaclean/genoa/option-e-lsd/schema/manifest.v1.json",
  "title": "LSD Manifest",
  "description": "Schema version 1.0.0 — lsd.toml manifest for Linux→QEMU→mfsBSD trampoline installer",
  "version": "1.0.0",
  "type": "object",
  "required": ["lsd_schema_version", "target", "base", "network", "trust"],
  "additionalProperties": false,
  "properties": {
    "lsd_schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "SemVer schema version; must start with 1."
    },
    "target": {
      "type": "object",
      "required": ["provider", "plan", "region"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["hetzner-cloud", "hetzner-robot", "oci", "digitalocean"],
          "description": "Cloud provider identifier"
        },
        "plan": {
          "type": "string",
          "description": "Provider-specific instance/server type (e.g. cax11, VM.Standard.A1.Flex)"
        },
        "region": {
          "type": "string",
          "description": "Provider-specific region/AZ (e.g. nbg1, us-ashburn-1)"
        },
        "rescue_image": {
          "type": "string",
          "description": "Override the rescue Linux image used for the trampoline (optional)"
        }
      }
    },
    "base": {
      "type": "object",
      "required": ["os", "version", "arch", "filesystem"],
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "enum": ["freebsd", "netbsd"],
          "description": "Target BSD operating system"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(-RELEASE|-CURRENT|-STABLE)?$",
          "description": "OS version string (e.g. 15.0-RELEASE)"
        },
        "arch": {
          "type": "string",
          "enum": ["amd64", "aarch64"],
          "description": "Target CPU architecture"
        },
        "filesystem": {
          "type": "string",
          "enum": ["zfs", "ufs"],
          "description": "Root filesystem type for the installed BSD"
        },
        "mfsbsd_url": {
          "type": "string",
          "format": "uri",
          "description": "Override the mfsBSD ISO URL (optional; catalog default used if absent)"
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["ssh_keys", "hostname"],
      "additionalProperties": false,
      "properties": {
        "ssh_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "SSH public key or provider key ID"
          },
          "description": "SSH public keys to inject into the installed BSD root account"
        },
        "hostname": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9\\-]{0,61}[a-z0-9]?$",
          "description": "Hostname for the installed BSD system"
        },
        "ipv6": {
          "type": "boolean",
          "default": false,
          "description": "Whether IPv6 is expected (some providers do not support this in custom-image mode)"
        }
      }
    },
    "trust": {
      "type": "object",
      "required": ["mfs_image_sha256"],
      "additionalProperties": false,
      "properties": {
        "mfs_image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 hex digest of the expected mfsBSD ISO"
        },
        "provenance_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to a signed provenance document (SLSA, sigstore, or plain HTTPS)"
        },
        "callback_url": {
          "type": "string",
          "format": "uri",
          "description": "Optional URL to POST to upon successful BSD installation (bootstrap.sh will curl this)"
        }
      }
    }
  }
}
